# Copy to .env (git-ignored) or set in the IDE run configuration. Never commit real values.
# Production: see docs/deploy.md (full list) and render.yaml.
DB_URL=jdbc:postgresql://HOST_FROM_SUPABASE_CONNECT:5432/postgres?sslmode=require
DB_USERNAME=postgres.PROJECT_REF
DB_PASSWORD=
DB_SCHEMA=fixgo
JWT_SECRET=            # Base64 of >= 32 random bytes (see docs/supabase-setup.md §3)
OTP_DEV_ECHO=true      # dev only: return OTP code in /auth/otp response. MUST be false in production
BOOTSTRAP_ADMIN_PHONE= # e.g. +84900000001 — creates the first ADMIN (no password, logs in via OTP)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://exe201-fix-go.github.io

# --- Production only (SPRING_PROFILES_ACTIVE=prod refuses to start with dev-style values) ---
# SPRING_PROFILES_ACTIVE=prod
# SMS_PROVIDER=esms            # default "log" just prints the OTP; ESMS_API_KEY / ESMS_SECRET_KEY / ESMS_BRANDNAME are required
# STORAGE_PROVIDER=supabase    # default "local" keeps uploads on this machine's disk; needs SUPABASE_URL + SUPABASE_SERVICE_KEY
# TRUSTED_PROXY_HOPS=1         # proxies in front of the app (Render: 1); 0 = trust no X-Forwarded-For
# DISPATCH_LOCATION_MAX_AGE=5m # skip partners whose last GPS ping is older; 0s = off
# DISABLED_SERVICE_CODES=towing
